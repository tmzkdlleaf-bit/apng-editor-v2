{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APNG Editor",
  "version": "../package.json",
  "identifier": "com.apng-editor.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "APNG 에디터",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "코코포리아 APNG·WebP 제작 도구",
    "longDescription": "코코포리아 사용자를 위한 브라우저·데스크톱 APNG·애니메이션 WebP 제작 도구.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
